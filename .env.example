# ==============================================================================
# 🌐 CONFIGURACIÓN GENERAL DEL SERVIDOR
# ==============================================================================
# Entorno de ejecución de la aplicación:
#   - development : Errores detallados, recarga en caliente y sin optimizaciones agresivas.
#   - staging     : Entorno previo a producción para pruebas y QA de clientes.
#   - production  : Máximo rendimiento, logging seguro y optimizaciones activas.
#   - test        : Ejecución de suites de pruebas unitarias o de integración.
NODE_ENV=development

# Red y Exposición de Puertos:
#   - HOST_IP: IP del host donde se enlaza el puerto.
#              Usar 127.0.0.1 para restringir solo a local, 0.0.0.0 para todas las interfaces,
#              o la IP de la interfaz interna (ej. 192.168.1.x) para tráfico entre contenedores/nodos.
HOST_IP=127.0.0.1
HOST_PORT={{HOST_PORT}}
CONTAINER_PORT={{CONTAINER_PORT}}
APP_PORT={{CONTAINER_PORT}}
LOG_LEVEL=info

# ==============================================================================
# 🐳 CONTENEDOR Y REGISTRO OCI (GHCR)
# ==============================================================================
REGISTRY=ghcr.io
IMAGE_NAME={{GITHUB_REPOSITORY}}

# Etiqueta (Tag) de la imagen OCI a consumir:
#   - staging            : Versión generada automáticamente desde la rama 'develop' (QA/Pruebas).
#   - latest             : Versión productiva consolidada desde la rama 'main'.
#   - vX.Y.Z (ej. 1.0.0) : Versión fija e inmutable correspondiente a un Release SemVer.
#   - dev-<commit>       : Hash específico para pruebas o diagnóstico puntual.
IMAGE_TAG=staging

CONTAINER_NAME={{PROJECT_NAME}}-app

# ==============================================================================
# 🔐 AUTENTICACIÓN Y SEGURIDAD (Valores de ejemplo, reemplazar en .env)
# ==============================================================================
JWT_SECRET=super_secret_key_change_me_in_production

# Origen permitido para solicitudes web desde el navegador (CORS):
#   - http://localhost:3000       : Típico frontend local (React, Next, Solid).
#   - https://app.midominio.com   : Dominio de producción del cliente web.
#   - *                           : Permitir cualquier origen (solo APIs públicas).
CORS_ORIGIN=http://localhost:3000
