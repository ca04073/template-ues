# ==============================================================================
# 🗄️ PERSISTENCIA / POSTGRESQL (Módulo Opcional)
# ==============================================================================
# Versión de la imagen oficial de PostgreSQL
POSTGRES_VERSION=16-alpine

# Nombre del contenedor y volumen dedicado
POSTGRES_CONTAINER_NAME={{PROJECT_NAME}}-postgres
POSTGRES_VOLUME_NAME={{PROJECT_NAME}}_pgdata

# Credenciales de base de datos local
POSTGRES_DB={{PROJECT_NAME}}_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# URL de conexión para la aplicación backend:
# - En desarrollo local (mismo host): postgresql://postgres:postgres@127.0.0.1:5432/{{PROJECT_NAME}}_db
# - Si la app y postgres corren en la misma red de compose: postgresql://postgres:postgres@postgres:5432/{{PROJECT_NAME}}_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/{{PROJECT_NAME}}_db
DB_MAX_CONNECTIONS=10
