# ====================================================================
# 🔄 NORMALIZACIÓN DE SALTOS DE LÍNEA (LF obligatorio en repos)
# ====================================================================
* text=auto eol=lf

# Scripts de terminal ejecutables en Linux / contenedores
*.sh text eol=lf
gradlew text eol=lf

# Scripts para entornos Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ====================================================================
# 📦 ARTEFACTOS Y ARCHIVOS BINARIOS
# ====================================================================
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary

# ====================================================================
# 🛡️ EXCLUSIÓN EN EXPORTACIONES Y RELEASES (git archive)
# ====================================================================
.github export-ignore
.devcontainer export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
