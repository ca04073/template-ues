# Función: Es el archivo de variables de entorno para tu backend (tu aplicación en Rust).
# Define credenciales de base de datos (DATABASE_URL), puertos locales o llaves secretas
# que tu servidor web lee al arrancar. Nota: Aunque el cliente HTTP no lo lee, 
# convive en tu espacio de trabajo para configurar la app que vas a probar.
# (Variables del Entorno del Sistema - Sí se sube a Git)

# Configuración del servidor / entorno de ejecución
PORT=8080
NODE_ENV=development

# Datos de conexión (Simulado)
DATABASE_URL=postgres://usuario:password_local@localhost:5432/mi_base_datos